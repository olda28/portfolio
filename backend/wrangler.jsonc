/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-16",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SPOTIFY",
				"class_name": "SpotifyObject"
			}
		]
	},
	"exports": {
		"SpotifyObject": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"secrets": {
		"required": ["SPOTIFY_BASIC_AUTH", "SPOTIFY_REFRESH_TOKEN"]
	}
}
